{
    "name": "angearsene/laravel-testing",
    "require": {
        "laravel/framework": "^12.42"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "AngeArsene\\LaravelTesting\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AngeArsene\\LaravelTesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "Ange Arsene",
            "email": "nkenmandenga@gmail.com"
        }
    ],
    "minimum-stability": "stable"
}